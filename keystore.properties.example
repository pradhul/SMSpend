# Copy to keystore.properties (untracked) to sign release builds locally.
# CI can instead set SMSPEND_KEYSTORE_FILE, SMSPEND_KEYSTORE_PASSWORD,
# SMSPEND_KEY_ALIAS and SMSPEND_KEY_PASSWORD as environment variables.
#
# Create a keystore once, and never lose it — Android updates must be signed
# with the same key:
#   keytool -genkey -v -keystore smspend-release.jks -alias smspend \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=/absolute/path/to/smspend-release.jks
storePassword=
keyAlias=smspend
keyPassword=
